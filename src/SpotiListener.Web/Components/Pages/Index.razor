@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable

@using System.Net
@using System.Net.Http.Json
@using SpotiListener.Core.Models

@inject IHttpClientFactory HttpClientFactory

<PageTitle>@pageTitle</PageTitle>

<div class="info-frame">
    <div class="photo">
        <a href="https://savelife.in.ua/en/"><img src="https://i.ibb.co/BNhj7Ly/main.webp" class="my-photo"></a>
    </div>
    <div class="song">
        <h2>Listens to ---------</h2>
        @if (_track is not null)
        {
            @if (HasAlbumCover())
            {
                <imf src = "@_track.SongPhoto" alt="(@_track.AlbumName) album cover" class="album-cover" />
            }

            <h3>Track: <span class="names">@_track.TrackName</span></h3>
            <h3>Artist: <span class="names">@_track.ArtistName</span></h3>
            <h3>Album: <span class="names">@_track.AlbumName</span></h3>
        }
        else
        {
            <h3>@_status</h3>
        }
    </div>
    
    <div class="abtme">
        <h3>Anna 18 Ukraine</h3>
        <h3>[ESTJ] Winter enjoyer</h3>
        <h3>C# Developer</h3>
    </div>
</div>
@code {

    private readonly CancellationTokenSource _cts = new();

    private Track? _track;
    private string _status = "Connecting to Spotify...";

    private string pageTitle = "@ihatemyspine's status";

    private Task? _pollingTask;

    private bool HasAlbumCover()
    {
        return Uri.TryCreate(_track?.SongPhoto, UriKind.Absolute, out var uri)
            && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshTrackAsync(_cts.Token);
        _pollingTask = PollTrackAsync(_cts.Token);
    }

    private async Task RefreshTrackAsync(CancellationToken cancellationToken)
    {
        try
        {
            var client = HttpClientFactory.CreateClient("Agent");

            using var response = await client.GetAsync("/api/track", cancellationToken);

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                _track = null;
                _status = "Nothing is playing...";
                return;
            }

            response.EnsureSuccessStatusCode();

            _track = await response.Content.ReadFromJsonAsync<Track>(cancellationToken: cancellationToken);

            _status = _track is null
                ? "Nothing is playing..."
                : string.Empty;
        }
        catch (HttpRequestException)
        {
            _track = null;
            _status = "Agent is unavailable.";
        }
    }

    private async Task PollTrackAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshTrackAsync(cancellationToken);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();

        if (_pollingTask is not null)
            await _pollingTask;

        _cts.Dispose();
    }
}